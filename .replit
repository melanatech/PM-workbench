modules = ["python-3.12", "nodejs-20", "bash", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[postMerge]
path = "pm-workbench/scripts/post-merge.sh"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Course preview"

[[workflows.workflow]]
name = "Course preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --directory docs --bind 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
