{
  "permissions": {
    "defaultMode": "dontAsk",
    "additionalDirectories": [
      "~/Downloads/pm-workbench-inbox"
    ],
    "allow": [
      "Read",
      "Edit(./outputs/**)",
      "Edit(./registers/**)",
      "Edit(./state/**)",
      "Edit(./logs/**)",
      "Edit(./learning/**)",
      "Edit(./archive/**)",
      "Edit(./inbox/**)",
      "Edit(./prototypes/**)",
      "Edit(./reference/user-research/**)",
      "Edit(./reference/metric-definitions/**)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(/usr/bin/python3 *)",
      "Bash(bash scripts/*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(printf *)",
      "Bash(date *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(*)",
      "Agent",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "mcp__plugin_atlassian_atlassian__*",
      "mcp__browser-bridge__*",
      "mcp__browser-bridge__browser_snapshot",
      "mcp__browser-bridge__browser_navigate",
      "mcp__browser-bridge__browser_navigate_back",
      "mcp__browser-bridge__browser_tabs",
      "mcp__browser-bridge__browser_take_screenshot",
      "mcp__browser-bridge__browser_wait_for",
      "mcp__browser-bridge__browser_console_messages",
      "mcp__ux_guardrails__*"
    ],
    "deny": [
      "mcp__browser-bridge__browser_click",
      "mcp__browser-bridge__browser_type",
      "mcp__browser-bridge__browser_fill_form",
      "mcp__browser-bridge__browser_select_option",
      "mcp__browser-bridge__browser_press_key",
      "mcp__browser-bridge__browser_drag",
      "mcp__browser-bridge__browser_hover",
      "mcp__browser-bridge__browser_file_upload",
      "mcp__browser-bridge__browser_evaluate",
      "mcp__browser-bridge__browser_run_code",
      "mcp__browser-bridge__browser_handle_dialog",
      "mcp__browser-bridge__browser_install",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D*)",
      "Bash(npm publish*)",
      "Bash(curl *-X POST*)",
      "Bash(curl *-X PUT*)",
      "Bash(curl *-X DELETE*)",
      "Bash(curl *--request POST*)",
      "Bash(curl *--request PUT*)",
      "Bash(curl *--request DELETE*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(diskutil erase*)",
      "Bash(diskutil eraseDisk*)",
      "Bash(diskutil eraseVolume*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /Users/*)",
      "Bash(rm -rf /Applications/*)",
      "Bash(rm -rf /System/*)",
      "Bash(rm -rf /Library/*)",
      "Bash(find * -delete*)",
      "Bash(brew upgrade*)",
      "Bash(apt-get upgrade*)",
      "Bash(apt upgrade*)",
      "Bash(yum update*)",
      "Bash(softwareupdate*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(curl *| bash*)",
      "Bash(curl *| sh*)",
      "Bash(csrutil*)",
      "Bash(nvram*)",
      "Bash(spctl*)",
      "Bash(systemsetup*)",
      "Bash(networksetup*)",
      "Bash(pmset*)",
      "Bash(launchctl load*/System/*)",
      "Bash(launchctl load*/Library/*)",
      "Bash(sudo *)",
      "Bash(dscl*)",
      "Bash(chown -R /*)",
      "Bash(chmod -R /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_register_write.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_context_preflight_for_repos.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_output_provenance.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_context_grounding.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_md_links.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_external_artifact.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_reply_links.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_run.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "prototype-build": "off",
    "todo": "off",
    "build": "off"
  }
}
